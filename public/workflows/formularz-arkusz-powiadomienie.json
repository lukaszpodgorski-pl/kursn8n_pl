      "webhookId": "ab38a556-d974-4c38-b2af-0ae36a579cf9"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const imie = ($json['Imię'] || '').trim();\nconst email = ($json['Email'] || '').trim().toLowerCase();\nconst wiadomosc = ($json['Wiadomość'] || '').trim();\n\n// Guard - formularz ma Required Field, ale nie ufaj wyłącznie walidacji przeglądarki\nif (!imie || !email) {\n  throw new Error('Brak wymaganych danych: pole \"Imię\" i \"Email\" są obowiązkowe.');\n}\n\nreturn {\n  json: {\n    imie,\n    email,\n    wiadomosc,\n    data_zgloszenia: $json.submittedAt\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300],
      "id": "code-waliduj-dane",
      "name": "Waliduj i oczyść dane"
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "ID_ARKUSZA"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Zgłoszenia"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Imię": "={{ $json.imie }}",
            "Email": "={{ $json.email }}",
            "Wiadomość": "={{ $json.wiadomosc }}",
            "Data zgłoszenia": "={{ $json.data_zgloszenia }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [680, 300],
      "id": "sheets-zapisz-zgloszenie",
      "name": "Zapisz zgłoszenie"
    },
    {
