---
import Default from '@astrojs/starlight/components/Head.astro';
import {
	SITE_URL,
	SITE_NAME,
	absoluteUrl,
	buildArticle,
	buildBreadcrumbs,
	buildCourse,
	buildFaqPage,
	buildWebSite,
	AUTHOR,
	type FaqItem,
} from '../lib/structured-data';
import { ARTICLE_SLUGS } from '../config/modules';

const route = Astro.locals.starlightRoute;
const data = route.entry.data;
const pathname = Astro.url.pathname;

const isHome = pathname === '/';

// Klasyfikacja jako allowlista oparta o rejestr ARTICLE_SLUGS - strona spoza
// rejestru (404, regulamin, prywatnosc) nie dostaje bloku artykulu, co dla
// danych strukturalnych jest bezpieczniejszym domyslnym zachowaniem.
// Nowy modul/gotowiec dopisany do ARTICLE_SLUGS w src/config/modules.ts
// klasyfikuje sie tu automatycznie.
const slug = pathname.split('/').filter(Boolean)[0];
const isArticle = slug !== undefined && ARTICLE_SLUGS.has(slug);

// Obraz OG generowany per strona przez src/pages/og/[...route].ts wylacznie
// dla wpisow kolekcji `docs`. Strona glowna (puste `id`) i 404 (spoza kolekcji)
// dostaja staly obraz domyslny, bo `/og/404.png` nigdy by nie powstal.
const ogImage = isArticle ? `${SITE_URL}/og/${route.id}.png` : `${SITE_URL}/og-default.png`;

const blocks: object[] = [];

if (isHome) {
	blocks.push(buildWebSite());
	blocks.push(buildCourse());
} else if (isArticle) {
	blocks.push(
		buildArticle({
			pathname,
			title: data.title,
			description: data.description,
			image: ogImage,
			dateModified: route.lastUpdated,
			datePublished: data.datePublished,
			educationalLevel: data.educationalLevel,
			teaches: data.teaches,
			about: data.about,
			mentions: data.mentions,
		}),
	);
	blocks.push(buildBreadcrumbs(pathname, data.title));
}

// Niezalezne od klasyfikacji - FAQPage dokleja sie do blokow, ktore juz
// powstaly, o ile artykul ma wypelnione pole `faq`.
const faq = data.faq as FaqItem[] | undefined;
if (faq && faq.length > 0) blocks.push(buildFaqPage(faq));

// Analityka: Matomo (self-hosted), tryb cookieless - nie ustawia zadnych
// cookies i respektuje Do Not Track, dzieki czemu nie wymaga zgody (RODO) i
// strona nie potrzebuje bannera cookies (szczegoly na /prywatnosc/). Wstrzykiwana
// TYLKO w buildzie produkcyjnym (import.meta.env.PROD), zeby dev/preview nie
// liczyly odslon. Odtworzone 1:1 z dawnego public_html/partials/analytics.php.
const ANALYTICS_URL = 'https://analytics.kursn8n.pl/';
const ANALYTICS_SITE_ID = '1';

const matomoScript = `
var _paq = window._paq = window._paq || [];
_paq.push(['disableCookies']);       // tryb bez cookies
_paq.push(['setDoNotTrack', true]);  // respektuj Do Not Track przegladarki
_paq.push(['trackPageView']);
_paq.push(['enableLinkTracking']);
(function () {
  var u = "${ANALYTICS_URL}";
  _paq.push(['setTrackerUrl', u + 'matomo.php']);
  _paq.push(['setSiteId', '${ANALYTICS_SITE_ID}']);
  var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
  g.async = true; g.src = u + 'matomo.js'; s.parentNode.insertBefore(g, s);
})();
`;
---

<Default><slot /></Default>

<meta name="author" content={AUTHOR.name} />
<link rel="author" href={AUTHOR.url} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${data.title} - ${SITE_NAME}`} />
<meta name="twitter:image" content={ogImage} />
<link rel="alternate" type="text/plain" href={absoluteUrl('/llms.txt')} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${SITE_NAME} - nowe materiały`}
	href={absoluteUrl('/feed.xml')}
/>

{blocks.map((block) => (
	<script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
))}

{import.meta.env.PROD && <script is:inline set:html={matomoScript} />}
